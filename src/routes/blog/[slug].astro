---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getBlogPosts } from '../../lib/content';
import '../../styles/prism-one-dark.css';

export async function getStaticPaths() {
    const posts = await getBlogPosts();
    return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} disableGutters>
    <Fragment slot="head">
        <meta property="article:published_time" content={formatDate(post.data.date)} />
    </Fragment>
    <article class="post">
        <Content />
    </article>
</BaseLayout>

<style>
    .post {
        line-height: 1.6;
    }

    .post :global(h1),
    .post :global(h2),
    .post :global(h3),
    .post :global(h4),
    .post :global(h5),
    .post :global(h6) {
        margin-top: 1em;
        margin-bottom: 0.5em;
        color: var(--color-text);
    }

    .post :global(p) {
        margin-bottom: 1.2em;
        color: var(--color-text);
    }

    /* Inline code */
    .post :global(code) {
        background-color: #004d4020;
        padding: 0.2em 0.4em;
        border-radius: 1rem;
        font-family: monospace;
    }

    .post :global(img) {
        max-width: 1000px;
    }

    .post :global(pre) {
        margin: 1em 0;
        border-radius: 5px;
        overflow: auto;
    }

    /* Highlighted code blocks; token colors come from prism-one-dark.css */
    .post :global(pre > code) {
        display: block;
        margin: 0.5em 0;
        padding: 1em;
        overflow: auto;
        font-family: var(--font-code);
        font-size: 1rem;
        line-height: 1.5;
        color: hsl(220, 14%, 71%);
        background: hsl(220, 13%, 18%);
        border-radius: 0.3em;
        text-shadow: 0 1px rgba(0, 0, 0, 0.3);
        direction: ltr;
        text-align: left;
        white-space: pre;
        word-spacing: normal;
        word-break: normal;
        tab-size: 2;
        hyphens: none;
    }
</style>
